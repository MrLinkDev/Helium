<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    
    <!-- 
    Dimensions documentation 
    
    {param_name}        - default value (1x)
    {param_name}{A}{B}X - value with scale A.Bx. 
    
    Example: Height15X = Height * 1.5
             Height20X = Height * 2.0
             
    {param_name}{A}     - value = {A} 
    
    Example: Radius4 = 4
             Radius8 = 8
    -->
    
    <!-- Height -->
    <system:Double x:Key="Height">28</system:Double>
    <system:Double x:Key="Height15X">42</system:Double>
    <system:Double x:Key="Height20X">56</system:Double>
    
    <!-- Width -->
    <system:Double x:Key="Width">70</system:Double>
    <system:Double x:Key="Width15X">70</system:Double>
    <system:Double x:Key="Width20X">140</system:Double>
    
    <!-- Corner Radius -->
    <CornerRadius x:Key="Radius4">4</CornerRadius>
    <CornerRadius x:Key="Radius8">8</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    
    <!-- Thickness -->
    <Thickness x:Key="Thickness1">1</Thickness>
    
    
</ResourceDictionary>