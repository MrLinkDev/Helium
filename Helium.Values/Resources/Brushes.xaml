<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Brush x:Key="WhiteBrush">#ffffff</Brush>
    <Brush x:Key="BlackBrush">#212121</Brush>
    
    <!-- Primary brushes -->
    <Brush x:Key="PrimaryBrush50">#f2f5fc</Brush>
    <Brush x:Key="PrimaryBrush100">#e1e9f8</Brush>
    <Brush x:Key="PrimaryBrush200">#cad9f3</Brush>
    <Brush x:Key="PrimaryBrush300">#a5c1eb</Brush>
    <Brush x:Key="PrimaryBrush400">#7aa1e0</Brush>
    <Brush x:Key="PrimaryBrush500">#5a82d7</Brush>          
    <Brush x:Key="PrimaryBrush600">#4666ca</Brush>
    <Brush x:Key="PrimaryBrush700">#3c55b9</Brush>
    <Brush x:Key="PrimaryBrush800">#32418b</Brush>          <!-- lock -->
    <Brush x:Key="PrimaryBrush900">#303e78</Brush>
    <Brush x:Key="PrimaryBrush950">#21284a</Brush>
    
    <!-- Attention brushes -->
    <Brush x:Key="AttentionBrush50">#fcf4f4</Brush>
    <Brush x:Key="AttentionBrush100">#fae6e6</Brush>
    <Brush x:Key="AttentionBrush200">#f7d1d1</Brush>
    <Brush x:Key="AttentionBrush300">#f0b1b1</Brush>
    <Brush x:Key="AttentionBrush400">#e68383</Brush>
    <Brush x:Key="AttentionBrush500">#d85b5b</Brush>
    <Brush x:Key="AttentionBrush600">#c43e3e</Brush>
    <Brush x:Key="AttentionBrush700">#a43131</Brush>
    <Brush x:Key="AttentionBrush800">#832a2a</Brush>        <!-- lock -->
    <Brush x:Key="AttentionBrush900">#722a2a</Brush>
    <Brush x:Key="AttentionBrush950">#3d1212</Brush>
    
    
</ResourceDictionary>