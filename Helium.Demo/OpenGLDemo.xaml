<window:HeWindow x:Class="HeliumDemo.OpenGLDemo"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:HeliumDemo"
                 xmlns:window="clr-namespace:Helium.Controls.Window;assembly=Alexander.Gorbunov.Helium"
                 xmlns:plot="clr-namespace:Helium.Controls.Plot;assembly=Alexander.Gorbunov.Helium"
                 mc:Ignorable="d"
                 Title="OpenGLDemo" 
                 Height="820" 
                 Width="1280"
                 Background="#212121">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="Azure"/>
            </Style>
        </Grid.Resources>

        <plot:HePlot
            x:Name="Plot"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="4"/>
        
        <DockPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            LastChildFill="False">

            <Label
                DockPanel.Dock="Top"
                Content="Trace Id:"
                Padding="0"
                Margin="4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreaseTraceId"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreaseTraceId_OnClick"/>

                <Button
                    x:Name="DecreaseTraceId"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-" 
                    Click="DecreaseTraceId_OnClick"/>

                <TextBox
                    x:Name="TraceId"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="1" />
            </DockPanel>


            <Button
                x:Name="AddTrace"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Add Trace" 
                Click="AddTrace_OnClick"/>

            <Button
                x:Name="SelectTrace"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Select Trace" 
                Click="SelectTrace_OnClick"/>

            <Button
                x:Name="AutoScaleTrace"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Auto Scale Trace" 
                Click="AutoScaleTrace_OnClick"/>
            
            <DockPanel DockPanel.Dock="Top" Margin="4">
                <Label
                    DockPanel.Dock="Left"
                    Content="X_U:"
                    Padding="0"
                    Margin="0, 0, 4, 0" />
                <Button
                    x:Name="SetUnitsX"
                    DockPanel.Dock="Right"
                    Margin="4, 0, 0, 0"
                    Content="Set" 
                    Click="SetUnitsX_OnClick"/>
                <ComboBox 
                    x:Name="UnitsBoxX"
                    DockPanel.Dock="Left"/>
            </DockPanel>
            
            <DockPanel DockPanel.Dock="Top" Margin="4">
                <Label
                    DockPanel.Dock="Left"
                    Content="Y_U:"
                    Padding="0"
                    Margin="0, 0, 4, 0" />
                <Button
                    x:Name="SetUnitsY"
                    DockPanel.Dock="Right"
                    Margin="4, 0, 0, 0"
                    Content="Set" 
                    Click="SetUnitsY_OnClick"/>
                <ComboBox 
                    x:Name="UnitsBoxY"
                    DockPanel.Dock="Left"/>
            </DockPanel>

            <Button
                x:Name="RemoveTrace"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Remove Trace" 
                Click="RemoveTrace_OnClick"/>
            <Label
                DockPanel.Dock="Top"
                Content="Points:"
                Padding="0"
                Margin="4, 16, 4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreasePoints"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreasePoints_OnClick"/>

                <Button
                    x:Name="DecreasePoints"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-"
                    Click="DecreasePoints_OnClick"/>

                <TextBox
                    x:Name="Points"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="101" />
            </DockPanel>
            
            <Label
                DockPanel.Dock="Top"
                Content="Start X:"
                Padding="0"
                Margin="4, 16, 4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreaseStartX"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreaseStartX_OnClick"/>

                <Button
                    x:Name="DecreaseStartX"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-" 
                    Click="DecreaseStartX_OnClick"/>

                <TextBox
                    x:Name="StartX"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="-1" />
            </DockPanel>

            <Label
                DockPanel.Dock="Top"
                Content="Stop X:"
                Padding="-1"
                Margin="4, 4, 4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreaseStopX"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreaseStopX_OnClick"/>

                <Button
                    x:Name="DecreaseStopX"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-" 
                    Click="DecreaseStopX_OnClick"/>

                <TextBox
                    x:Name="StopX"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="1" />
            </DockPanel>

            <Label
                DockPanel.Dock="Top"
                Content="Start Y:"
                Padding="0"
                Margin="4, 4, 4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreaseStartY"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreaseStartY_OnClick"/>

                <Button
                    x:Name="DecreaseStartY"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-" 
                    Click="DecreaseStartY_OnClick"/>

                <TextBox
                    x:Name="StartY"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="-1" />
            </DockPanel>
            
            <Label
                DockPanel.Dock="Top"
                Content="Stop Y:"
                Padding="0"
                Margin="4, 4, 4, 0"/>
            
            <DockPanel
                DockPanel.Dock="Top">
                
                <Button
                    x:Name="IncreaseStopY"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+"
                    Click="IncreaseStopY_OnClick"/>
                
                <Button
                    x:Name="DecreaseStopY"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-"
                    Click="DecreaseStopY_OnClick"/>
                
                <TextBox
                    x:Name="StopY"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="1"/>
            </DockPanel>

            <Button
                x:Name="UpdateData"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Update Data" 
                Click="UpdateData_OnClick"/>
            
            <Label
                DockPanel.Dock="Top"
                Content="Marker Id:"
                Padding="0"
                Margin="4, 16, 4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreaseMarkerId"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreaseMarkerId_OnClick"/>

                <Button
                    x:Name="DecreaseMarkerId"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-" 
                    Click="DecreaseMarkerId_OnClick"/>

                <TextBox
                    x:Name="MarkerId"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="1" />
            </DockPanel>
            
            <Label
                DockPanel.Dock="Top"
                Content="Marker X:"
                Padding="-1"
                Margin="4, 4, 4, 0" />

            <DockPanel
                DockPanel.Dock="Top">

                <Button
                    x:Name="IncreaseMarkerX"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="+" 
                    Click="IncreaseMarkerX_OnClick"/>

                <Button
                    x:Name="DecreaseMarkerX"
                    DockPanel.Dock="Right"
                    Margin="4"
                    Width="28"
                    Content="-" 
                    Click="DecreaseMarkerX_OnClick"/>

                <TextBox
                    x:Name="MarkerX"
                    DockPanel.Dock="Left"
                    Margin="4"
                    Text="0" />
            </DockPanel>

            <Button
                x:Name="AddMarker"
                DockPanel.Dock="Top"
                Margin="4, 16, 4, 4"
                Content="Add Marker" 
                Click="AddMarker_OnClick"/>

            <Button
                x:Name="SelectMarker"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Select Marker"
                Click="SelectMarker_OnClick"/>

            <Button
                x:Name="RemoveMarker"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Remove Marker" 
                Click="RemoveMarker_OnClick"/>

            <Button
                x:Name="SetMarkerX"
                DockPanel.Dock="Top"
                Margin="4"
                Content="Set Marker X" 
                Click="SetMarkerX_OnClick"/>
            
            <DockPanel DockPanel.Dock="Top" Margin="4">
                <Button
                    x:Name="SetMarkerFunc"
                    DockPanel.Dock="Right"
                    Margin="4, 0, 0, 0"
                    Content="Set" 
                    Click="SetMarkerFunc_OnClick"/>
                <ComboBox 
                    x:Name="MarkerFunc"
                    DockPanel.Dock="Left"
                    Margin="0, 0, 4, 0" />
            </DockPanel>

        </DockPanel>
    </Grid>
</window:HeWindow>