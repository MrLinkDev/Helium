<Window x:Class="HeliumDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeliumDemo"
        xmlns:buttons="clr-namespace:Helium.Button;assembly=Helium.Button"
        xmlns:cardView="clr-namespace:Helium.CardView;assembly=Helium.CardView"
        xmlns:imageButton="clr-namespace:Helium.ImageButton;assembly=Helium.ImageButton"

        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Background="#212121"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <DockPanel
            Grid.Column="0"
            LastChildFill="False">
            <buttons:HeButtonFlat
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                Text="Default">
            </buttons:HeButtonFlat>
            
            <buttons:HeButtonFlat
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                IsEnabled="False"
                Text="Disabled">
            </buttons:HeButtonFlat>
        </DockPanel>
        
        <DockPanel
            Grid.Column="1"
            LastChildFill="False">
            <buttons:HeButtonBezel
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                Text="Default">
            </buttons:HeButtonBezel>
            
            <buttons:HeButtonBezel
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                IsEnabled="False"
                Text="Disabled">
            </buttons:HeButtonBezel>
        </DockPanel>
        
        <DockPanel
            Grid.Column="2"
            LastChildFill="False">
            <imageButton:HeImageButtonBezel
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                ImageSource="/Helium.Resources;component/Resources/Icons/32px/close_icon.png"/>
            
            <imageButton:HeImageButtonBezel
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                IsEnabled="False"
                ImageSourceDisabled="/Helium.Resources;component/Resources/Icons/32px/maximize_icon.png"
                ImageSource="/Helium.Resources;component/Resources/Icons/32px/close_icon.png"/>
            
        </DockPanel>
        
        <DockPanel
            Grid.Column="3"
            LastChildFill="False">
            <imageButton:HeImageButtonFlat
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                ImageSource="/Helium.Resources;component/Resources/Icons/32px/close_icon.png"/>
            
            <imageButton:HeImageButtonFlat
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                IsEnabled="False"
                ImageSourceDisabled="/Helium.Resources;component/Resources/Icons/32px/maximize_icon.png"
                ImageSource="/Helium.Resources;component/Resources/Icons/32px/close_icon.png"/>
            
        </DockPanel>
    </Grid>
</Window>