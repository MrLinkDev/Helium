<window:HeWindow x:Class="HeliumDemo.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:HeliumDemo"
                 xmlns:button="clr-namespace:Helium.Controls.Button;assembly=Alexander.Gorbunov.Helium"
                 xmlns:imageButton="clr-namespace:Helium.Controls.ImageButton;assembly=Alexander.Gorbunov.Helium"
                 xmlns:radioButton="clr-namespace:Helium.Controls.RadioButton;assembly=Alexander.Gorbunov.Helium"
                 xmlns:resources="clr-namespace:Helium.Resources;assembly=Alexander.Gorbunov.Helium"
                 xmlns:checkBox="clr-namespace:Helium.Controls.CheckBox;assembly=Alexander.Gorbunov.Helium"
                 xmlns:editText="clr-namespace:Helium.Controls.EditText;assembly=Alexander.Gorbunov.Helium"
                 xmlns:xButton="clr-namespace:Helium.Controls.XValueButton;assembly=Alexander.Gorbunov.Helium"
                 xmlns:xValueButton="clr-namespace:Helium.Controls.XValueButton;assembly=Alexander.Gorbunov.Helium"
                 xmlns:xRadioButton="clr-namespace:Helium.Controls.XRadioButton;assembly=Alexander.Gorbunov.Helium"
                 xmlns:indicator="clr-namespace:Helium.Controls.Indicator;assembly=Alexander.Gorbunov.Helium"
                 xmlns:switch="clr-namespace:Helium.Controls.Switch;assembly=Alexander.Gorbunov.Helium"
                 xmlns:system="clr-namespace:System;assembly=System.Runtime"
                 xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
                 xmlns:tabControl="clr-namespace:Helium.Controls.TabControl;assembly=Alexander.Gorbunov.Helium"
                 xmlns:comboBox="clr-namespace:Helium.Controls.ComboBox;assembly=Alexander.Gorbunov.Helium"
                 xmlns:xCheckButton="clr-namespace:Helium.Controls.XCheckButton;assembly=Alexander.Gorbunov.Helium"
                 xmlns:window="clr-namespace:Helium.Controls.Window;assembly=Alexander.Gorbunov.Helium"
                 xmlns:xCheckValueButton="clr-namespace:Helium.Controls.XCheckValueButton;assembly=Alexander.Gorbunov.Helium"

                 mc:Ignorable="d"
                 Title="MainWindow"
                 Height="720"
                 Width="1280"
                 Background="#212121"
                 WindowStartupLocation="CenterScreen"
                 WindowTitle="Helium Demo">

    <window:HeWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Dimensions.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </window:HeWindow.Resources>

    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type button:HeButton}">
                <Setter Property="Width" Value="{StaticResource Width12X}" />
                <Setter Property="Height" Value="{StaticResource Height}" />
            </Style>

            <Style TargetType="{x:Type imageButton:HeImageButton}">
                <Setter Property="Width" Value="{StaticResource Height}" />
                <Setter Property="Height" Value="{StaticResource Height}" />
                <Setter Property="ImageHeight" Value="16" />
                <Setter Property="ImageWidth" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <DockPanel
            Grid.Column="0"
            LastChildFill="False"
            Margin="16">

            <Grid
                DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <DockPanel
                    Grid.Column="0"
                    LastChildFill="False">
                    <button:HeButton
                        DockPanel.Dock="Top"
                        Text="very very looooong text"
                        Height="Auto"
                        HeType="Bezel"
                        Click="ButtonBase_OnClick" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 8,0, 0"
                        Text="Disabled"
                        IsEnabled="False"
                        HeType="Bezel" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 16,0, 0"
                        Text="Default"
                        HeType="Bezel"
                        HeTheme="Attention" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 8,0, 0"
                        Text="Disabled"
                        IsEnabled="False"
                        HeType="Bezel"
                        HeTheme="Attention" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 16,0, 0"
                        Text="Default"
                        HeType="Bezel"
                        HeTheme="Black" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 8,0, 0"
                        Text="Disabled"
                        IsEnabled="False"
                        HeType="Bezel"
                        HeTheme="Black" />
                </DockPanel>

                <DockPanel
                    Grid.Column="1"
                    LastChildFill="False"
                    Margin="8, 0, 0, 0">
                    <button:HeButton
                        DockPanel.Dock="Top"
                        Text="Default"
                        HeType="Flat" 
                        Click="IncreaseXButtonTestVal"/>

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 8,0, 0"
                        Text="Disabled"
                        IsEnabled="False"
                        HeType="Flat" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 16,0, 0"
                        Text="Default"
                        HeType="Flat"
                        HeTheme="Attention" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 8,0, 0"
                        Text="Disabled"
                        IsEnabled="False"
                        HeType="Flat"
                        HeTheme="Attention" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 16,0, 0"
                        Text="Default"
                        HeType="Flat"
                        HeTheme="Black" />

                    <button:HeButton
                        DockPanel.Dock="Top"
                        Margin="0, 8,0, 0"
                        Text="Disabled"
                        IsEnabled="False"
                        HeType="Flat"
                        HeTheme="Black" />
                </DockPanel>
            </Grid>

            <Grid
                DockPanel.Dock="Top">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Margin="0, 16, 0, 0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <DockPanel
                        Grid.Column="0"
                        LastChildFill="False">
                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Bezel" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Bezel" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 16,0, 0"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Bezel"
                            HeTheme="Attention" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Bezel"
                            HeTheme="Attention" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 16,0, 0"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Bezel"
                            HeTheme="Black" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Bezel"
                            HeTheme="Black" />
                        
                        <comboBox:HeComboBox
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            SelectedIndex="0">
                            <system:String>Tom</system:String>
                            <system:String>Bob</system:String>
                            <system:String>Sam</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                            <system:String>Alice</system:String>
                        </comboBox:HeComboBox>
                        
                        <comboBox:HeComboBox
                            DockPanel.Dock="Top"
                            IsEnabled="False"
                            SelectedIndex="0"
                            Margin="0, 8,0, 0">
                            <system:String>Tom</system:String>
                            <system:String>Bob</system:String>
                            <system:String>Sam</system:String>
                            <system:String>Alice</system:String>
                        </comboBox:HeComboBox>
                        
                        <comboBox:HeComboBox
                            DockPanel.Dock="Top"
                            IsEditable="True"
                            SelectedIndex="0"
                            Margin="0, 8,0, 0">
                            <system:String>Tom</system:String>
                            <system:String>Bob</system:String>
                            <system:String>Sam</system:String>
                            <system:String>Alice</system:String>
                        </comboBox:HeComboBox>
                        
                        <comboBox:HeComboBox
                            DockPanel.Dock="Top"
                            IsEditable="True"
                            IsEnabled="False"
                            SelectedIndex="0"
                            Margin="0, 8,0, 0">
                            <system:String>Tom</system:String>
                            <system:String>Bob</system:String>
                            <system:String>Sam</system:String>
                            <system:String>Alice</system:String>
                        </comboBox:HeComboBox>
                    </DockPanel>

                    <DockPanel
                        Grid.Column="1"
                        LastChildFill="False">
                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Flat" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Flat" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 16,0, 0"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Flat"
                            HeTheme="Attention" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Flat"
                            HeTheme="Attention" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 16,0, 0"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Flat"
                            HeTheme="Black" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Flat"
                            HeTheme="Black" />
                    </DockPanel>
                </Grid>

                <Grid
                    Grid.Column="1"
                    Margin="0, 16, 0, 0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <DockPanel
                        Grid.Column="0"
                        LastChildFill="False">
                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Transparent" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Transparent" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 16,0, 0"
                            ImageSource="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            HeType="Transparent"
                            HeTheme="Attention" />

                        <imageButton:HeImageButton
                            DockPanel.Dock="Top"
                            Margin="0, 8,0, 0"
                            ImageSourceDisabled="/Alexander.Gorbunov.Helium;component/Resources/Icons/app_icon.png"
                            IsEnabled="False"
                            HeType="Transparent"
                            HeTheme="Attention" />
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <DockPanel
            Grid.Column="1"
            LastChildFill="False"
            Margin="0, 16, 16, 16">

            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                Content="Embedded Content 1" />

            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                Content="Embedded Content 2" />

            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                IsEnabled="False"
                Content="Embedded Content Disabled" />

            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0">
                <radioButton:HeRadioButton.Content>
                    <Label
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Custom Content 1" />
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>

            <radioButton:HeRadioButton
                DockPanel.Dock="Top">
                <radioButton:HeRadioButton.Content>
                    <Label
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Custom Content 2" />
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>

            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                IsEnabled="False">
                <radioButton:HeRadioButton.Content>
                    <Label
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Custom Content Disabled" />
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>

            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0"
                Content="Embedded Content" />

            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                IsEnabled="False"
                Content="Embedded Content Disabled" />

            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0">
                <checkBox:HeCheckBox.Content>
                    <Label
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Custom Content" />
                </checkBox:HeCheckBox.Content>
            </checkBox:HeCheckBox>

            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                IsEnabled="False">
                <checkBox:HeCheckBox.Content>
                    <Label
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Custom Content Disabled" />
                </checkBox:HeCheckBox.Content>
            </checkBox:HeCheckBox>

            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                CheckBoxHeight="24"
                CheckBoxWidth="24"
                Margin="0, 16, 0, 0">
                <checkBox:HeCheckBox.Content>
                    <Label
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Oversized checkbox" />
                </checkBox:HeCheckBox.Content>
            </checkBox:HeCheckBox>

            <!-- <switch:HeSwitch -->
            <!--     DockPanel.Dock="Top" -->
            <!--     Height="40" -->
            <!--     Margin="0, 16, 0, 0"> -->
            <!--     <switch:HeSwitch.Values> -->
            <!--         <x:Array Type="{x:Type system:String}"> -->
            <!--             <system:String>0</system:String> -->
            <!--             <system:String>1</system:String> -->
            <!--             <system:String>2</system:String> -->
            <!--             <system:String>3</system:String> -->
            <!--             <system:String>4</system:String> -->
            <!--         </x:Array> -->
            <!--     </switch:HeSwitch.Values> -->
            <!-- </switch:HeSwitch> -->
            <!-- -->
            <!-- <switch:HeSwitch -->
            <!--     DockPanel.Dock="Top" -->
            <!--     Height="40" -->
            <!--     Margin="0, 16, 0, 0"> -->
            <!--     <switch:HeSwitch.Values> -->
            <!--         <x:Array Type="{x:Type system:String}"> -->
            <!--             <system:String>5</system:String> -->
            <!--             <system:String>6</system:String> -->
            <!--             <system:String>7</system:String> -->
            <!--             <system:String>8</system:String> -->
            <!--             <system:String>9</system:String> -->
            <!--         </x:Array> -->
            <!--     </switch:HeSwitch.Values> -->
            <!-- </switch:HeSwitch> -->
        </DockPanel>

        <DockPanel
            Grid.Column="2"
            Margin="0, 16, 16, 16"
            LastChildFill="False">

            <editText:HeEditText
                DockPanel.Dock="Top"
                Text="Enabled with text" />

            <editText:HeEditText
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                IsEnabled="False"
                Text="Disabled with text" />

            <editText:HeEditText
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0"
                EditTextHint="Enabled with hint" />

            <editText:HeEditText
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                IsEnabled="False"
                EditTextHint="Disabled with hint" />

            <editText:HeEditText
                x:Name="ValidationErrorEnabled"
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0"
                Text="{Binding DoubleData, UpdateSourceTrigger=PropertyChanged}" />

            <editText:HeEditText
                x:Name="ValidationErrorDisabled"
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                IsEnabled="False"
                Text="{Binding DoubleData, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <DockPanel
            Grid.Column="3"
            LastChildFill="False"
            Margin="0, 16, 16, 16">

            <xValueButton:HeXValueButton
                DockPanel.Dock="Top"
                ValueName="Start"
                FullValueName="Start Frequency"
                XValueType="FREQUENCY"
                Value="{Binding XValueButtonTestVal}" />

            <xValueButton:HeXValueButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                IsEnabled="False"
                ValueName="Stop" />

            <xValueButton:HeXValueButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                XValueType="DBM"
                ValueName="Power"
                FullValueName="Power" />

            <xValueButton:HeXValueButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                ValueName="Points"
                FullValueName="Points"
                XValueType="NONE" />


            <xRadioButton:HeXRadioButton
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0"
                Content="АЧХ" />

            <xRadioButton:HeXRadioButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                Content="XRadio 2" />

            <xRadioButton:HeXRadioButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                Content="Disabled"
                IsEnabled="False" />
            
            <xCheckButton:HeXCheckButton
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0"
                Id="1"
                Text="XCheck 1" 
                IsActive="{Binding IsActiveBinding, Mode=TwoWay}"
                IsActiveCommand="{Binding IsOnCmd}"
                IsCheckedCommand="{Binding IsCheckCmd}"/>

            <xCheckButton:HeXCheckButton
                DockPanel.Dock="Top"
                Id="2"
                Margin="0, 8, 0, 0"
                Text="XCheck 2" />

            <xCheckButton:HeXCheckButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                Text="Disabled"
                IsEnabled="False" />
            
            <xCheckValueButton:HeXCheckValueButton
                DockPanel.Dock="Top"
                Margin="0, 16, 0, 0"
                Id="1"
                ValueName="XCheckV 1"
                MinValue="5"
                Value="100"
                MaxValue="500"
                IsActiveCommand="{Binding IsOnCmd}"
                IsCheckedCommand="{Binding IsCheckCmd}"/>

            <xCheckValueButton:HeXCheckValueButton
                DockPanel.Dock="Top"
                Id="2"
                Margin="0, 8, 0, 0"
                
                ValueName="XCheckV 2"
                FullValueName="X CHECK VALUE 2"
                MinValue="5"
                Value="10"
                MaxValue="500" />

            <xCheckValueButton:HeXCheckValueButton
                DockPanel.Dock="Top"
                Margin="0, 8, 0, 0"
                ValueName="Disabled"
                MinValue="5"
                Value="100"
                MaxValue="500"
                IsEnabled="False" />
        </DockPanel>

        <DockPanel
            Grid.Column="4"
            LastChildFill="False"
            Margin="0, 16, 16, 0">

            <DockPanel
                DockPanel.Dock="Top"
                LastChildFill="False">

                <indicator:HeIndicator
                    x:Name="Indicator"
                    DockPanel.Dock="Left"
                    Margin="8" />

                <button:HeButton
                    DockPanel.Dock="Right"
                    Text="Indicator"
                    HeType="Flat"
                    Click="ChangeIndicatorState" />
            </DockPanel>
        </DockPanel>

        <DockPanel
            Grid.Column="5"
            LastChildFill="True">

            <tabControl:HeVTabControl
                DockPanel.Dock="Right">
                <tabControl:HeVTabControl.Items>
                    <tabControl:HeVTabItem Header="TabItem 1">
                        <button:HeButton Text="1" />
                    </tabControl:HeVTabItem>
                    <tabControl:HeVTabLabel Header="Label"/>
                    <tabControl:HeVTabItem IsEnabled="False" Header="TabItem 2">
                        <button:HeButton Text="2" />
                    </tabControl:HeVTabItem>
                    <tabControl:HeVTabItem Header="TabItem 3">
                        <tabControl:HeVTabControl Level="1">
                            <tabControl:HeVTabControl.Items>
                                <tabControl:HeVTabItem Header="TabItem 1">
                                    <button:HeButton Text="1" />
                                </tabControl:HeVTabItem>
                                <tabControl:HeVTabItem Header="TabItem 2">
                                    <button:HeButton Text="2" />
                                </tabControl:HeVTabItem>
                                <tabControl:HeVTabItem Header="TabItem 3">
                                    <button:HeButton Text="3" />
                                </tabControl:HeVTabItem>
                            </tabControl:HeVTabControl.Items>
                        </tabControl:HeVTabControl>
                    </tabControl:HeVTabItem>
                </tabControl:HeVTabControl.Items>
            </tabControl:HeVTabControl>

        </DockPanel>
    </Grid>
</window:HeWindow>