<window:HeWindow x:Class="HeliumDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeliumDemo"
        xmlns:button="clr-namespace:Helium.Controls.Button;assembly=Helium"
        xmlns:imageButton="clr-namespace:Helium.Controls.ImageButton;assembly=Helium"
        xmlns:window="clr-namespace:Helium.Controls.Window;assembly=Helium"
        xmlns:radioButton="clr-namespace:Helium.Controls.RadioButton;assembly=Helium"
        xmlns:resources="clr-namespace:Helium.Resources;assembly=Helium"
        xmlns:checkBox="clr-namespace:Helium.Controls.CheckBox;assembly=Helium"

        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Background="#212121"
        WindowStartupLocation="CenterScreen"
        WindowTitle="Helium Demo">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <DockPanel
            Grid.Column="0"
            LastChildFill="False">
            
            <button:HeButtonFlat
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                Text="Default">
            </button:HeButtonFlat>
            
            <button:HeButtonFlat
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                IsEnabled="False"
                Text="Disabled">
            </button:HeButtonFlat>
            
            <radioButton:HeRadioButton
                DockPanel.Dock="Top">
                
                <radioButton:HeRadioButton.Content>
                    <Label Content="Embedded content"></Label>
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>
            
            <radioButton:HeRadioButton
                DockPanel.Dock="Top">
                
                <radioButton:HeRadioButton.Content>
                    <Label Content="Embedded content"></Label>
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>
            
            <radioButton:HeRadioButton
                DockPanel.Dock="Top">
                
                <radioButton:HeRadioButton.Content>
                    <Label Content="Embedded content"></Label>
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>
            
            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                IsEnabled="False"
                Content="Disabled String content">
            </radioButton:HeRadioButton>
            
            <radioButton:HeRadioButton
                DockPanel.Dock="Top"
                IsEnabled="False">
                
                <radioButton:HeRadioButton.Content>
                    <Label Content="Disabled Embedded content"></Label>
                </radioButton:HeRadioButton.Content>
            </radioButton:HeRadioButton>
        </DockPanel>
        
        <DockPanel
            Grid.Column="1"
            LastChildFill="False">
            <button:HeButtonBezel
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                Text="Default">
            </button:HeButtonBezel>
            
            <button:HeButtonBezel
                DockPanel.Dock="Top"
                Width="100"
                Height="32"
                Margin="8"
                IsEnabled="False"
                Text="Disabled">
            </button:HeButtonBezel>
            
            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                Content="Content 1"/>
            
            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                Content="Content 2"/>
            
            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                Content="Content 3"/>
            
            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                IsEnabled="False"
                Content="D Content"/>
            
            <checkBox:HeCheckBox
                DockPanel.Dock="Top"
                IsEnabled="False">
                <checkBox:HeCheckBox.Content>
                    <Label
                        VerticalAlignment="Center"
                        Content="DE Content"/>
                </checkBox:HeCheckBox.Content>
            </checkBox:HeCheckBox>
            
            <checkBox:HeCheckBox
                DockPanel.Dock="Top">
                <checkBox:HeCheckBox.Content>
                    <Label
                        VerticalAlignment="Center"
                        Content="E Content"/>
                </checkBox:HeCheckBox.Content>
            </checkBox:HeCheckBox>
        </DockPanel>
        
        <DockPanel
            Grid.Column="2"
            LastChildFill="False">
            <imageButton:HeImageButtonBezel
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                ImageSource="/Helium;component/Resources/Icons/close_icon.png"/>
            
            <imageButton:HeImageButtonBezel
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                IsEnabled="False"
                ImageSourceDisabled="/Helium;component/Resources/Icons/maximize_icon.png"
                ImageSource="/Helium;component/Resources/Icons/close_icon.png"/>
            
        </DockPanel>
        
        <DockPanel
            Grid.Column="3"
            LastChildFill="False">
            <imageButton:HeImageButtonFlat
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                ImageSource="/Helium;component/Resources/Icons/close_icon.png"/>
            
            <imageButton:HeImageButtonFlat
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                IsEnabled="False"
                ImageSourceDisabled="/Helium;component/Resources/Icons/maximize_icon.png"
                ImageSource="/Helium;component/Resources/Icons/close_icon.png"/>
            
        </DockPanel>
        
        <DockPanel
            Grid.Column="4"
            LastChildFill="False">
            <imageButton:HeImageButtonFlatTransparent
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                ImageSource="/Helium;component/Resources/Icons/close_icon.png"/>
            
            <imageButton:HeImageButtonFlatTransparent
                DockPanel.Dock="Top"
                Width="32"
                Height="32"
                Margin="8"
                IsEnabled="False"
                ImageSourceDisabled="/Helium;component/Resources/Icons/maximize_icon.png"
                ImageSource="/Helium;component/Resources/Icons/close_icon.png"/>
            
        </DockPanel>
    </Grid>
</window:HeWindow>