<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium2.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium2;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium2;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium2;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="HeButtonFlatDefault" TargetType="{x:Type local:HeButton}">
        <Border
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"

            Background="{TemplateBinding Background}"

            CornerRadius="{TemplateBinding CornerRadius}"

            SnapsToDevicePixels="True">

            <TextBlock
                Width="{TemplateBinding Width}"
                Height="Auto"

                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"

                TextAlignment="Center"

                FontSize="{TemplateBinding FontSize}"
                FontFamily="{TemplateBinding FontFamily}"
                Foreground="{StaticResource PrimaryBrush50}"

                Margin="{TemplateBinding CornerRadius}"
                TextWrapping="WrapWithOverflow"

                Text="{TemplateBinding Content}" />
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="False">
                <Setter
                    Property="Background"
                    Value="{StaticResource PrimaryBrush500}" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter
                    Property="Background"
                    Value="{StaticResource PrimaryBrush600}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter
                    Property="Background"
                    Value="{StaticResource PrimaryBrush700}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter
                    Property="Background"
                    Value="{StaticResource PrimaryBrush950}" />

                <Setter
                    Property="Foreground"
                    Value="{StaticResource PrimaryBrush700}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:HeButton}">
        <Setter Property="Template" Value="{StaticResource HeButtonFlatDefault}"/>
    </Style>

</ResourceDictionary>
