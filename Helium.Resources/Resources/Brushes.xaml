<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Brush x:Key="WhiteBrush">#ffffff</Brush>
    <Brush x:Key="BlackBrush">#212121</Brush>
    
    <!-- Primary brushes -->
    <Brush x:Key="PrimaryBrush50">#f3f6fb</Brush>
    <Brush x:Key="PrimaryBrush100">#e3ebf6</Brush>
    <Brush x:Key="PrimaryBrush200">#ceddef</Brush>
    <Brush x:Key="PrimaryBrush300">#adc5e3</Brush>
    <Brush x:Key="PrimaryBrush400">#85a8d5</Brush>
    <Brush x:Key="PrimaryBrush500">#688cc9</Brush>          
    <Brush x:Key="PrimaryBrush600">#5574bb</Brush>
    <Brush x:Key="PrimaryBrush700">#4a62aa</Brush>
    <Brush x:Key="PrimaryBrush800">#41528c</Brush>          <!-- lock -->
    <Brush x:Key="PrimaryBrush900">#384670</Brush>
    <Brush x:Key="PrimaryBrush950">#262d45</Brush>
    
    <!-- Red Palette -->
    <Brush x:Key="AttentionBrush50">#fcf4f4</Brush>
    <Brush x:Key="AttentionBrush100">#fae6e6</Brush>
    <Brush x:Key="AttentionBrush200">#f7d1d1</Brush>
    <Brush x:Key="AttentionBrush300">#f0b1b1</Brush>
    <Brush x:Key="AttentionBrush400">#e68383</Brush>
    <Brush x:Key="AttentionBrush500">#d85b5b</Brush>
    <Brush x:Key="AttentionBrush600">#c43e3e</Brush>
    <Brush x:Key="AttentionBrush700">#a43131</Brush>
    <Brush x:Key="AttentionBrush800">#832a2a</Brush>        <!-- lock -->
    <Brush x:Key="AttentionBrush900">#722a2a</Brush>
    <Brush x:Key="AttentionBrush950">#3d1212</Brush>
    
    <!-- Black Palette -->
    <Brush x:Key="BlackBrush50">#f6f6f6</Brush>
    <Brush x:Key="BlackBrush100">#e7e7e7</Brush>
    <Brush x:Key="BlackBrush200">#d1d1d1</Brush>
    <Brush x:Key="BlackBrush300">#b0b0b0</Brush>
    <Brush x:Key="BlackBrush400">#888888</Brush>
    <Brush x:Key="BlackBrush500">#6d6d6d</Brush>
    <Brush x:Key="BlackBrush600">#5d5d5d</Brush>
    <Brush x:Key="BlackBrush700">#4f4f4f</Brush>
    <Brush x:Key="BlackBrush800">#454545</Brush>       
    <Brush x:Key="BlackBrush900">#3d3d3d</Brush>
    <Brush x:Key="BlackBrush950">#212121</Brush>            <!-- lock -->
    
    
</ResourceDictionary>