<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Helium.Values</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <Page Update="Resources\Brushes.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
      <Page Update="Resources\Colors.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
      <Page Update="Resources\Dimensions.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
      <Page Update="Resources\Icons\Paths\MinimizeIcon.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="Resources\Icons\Paths\MaximizeIcon.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <None Remove="Resources\Icons\32px\close_icon.png" />
      <Resource Include="Resources\Icons\32px\close_icon.png" />
      <None Remove="Resources\Icons\32px\maximize_icon.png" />
      <Resource Include="Resources\Icons\32px\maximize_icon.png" />
      <None Remove="Resources\Icons\32px\minimize_icon.png" />
      <Resource Include="Resources\Icons\32px\minimize_icon.png" />
      <None Remove="Resources\Icons\32px\normal_icon.png" />
      <Resource Include="Resources\Icons\32px\normal_icon.png" />
    </ItemGroup>

</Project>
