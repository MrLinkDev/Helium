<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.Controls.ImageButton">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Controls/ImageButton/Styles/HeImageButtonBase.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:HeImageButtonFlatTransparentAttention}" BasedOn="{StaticResource HeImageButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeImageButtonFlatTransparentAttention}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"

                        Background="{TemplateBinding Background}"

                        CornerRadius="0"

                        SnapsToDevicePixels="True">

                        <Grid>
                            <ContentControl>
                                <Image
                                    Width="{TemplateBinding ImageWidth}"
                                    Height="{TemplateBinding ImageHeight}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter 
                                                Property="Source" 
                                                Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ImageSource}"/>
                                            
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter 
                                                        Property="Source" 
                                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ImageSourceDisabled}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </ContentControl>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter 
                                Property="Background" 
                                Value="{StaticResource AttentionBrush700}"/>
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter 
                                Property="Background" 
                                Value="{StaticResource AttentionBrush800}"/>
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter 
                                Property="Background" 
                                Value="{StaticResource AttentionBrush950}"/>
                            
                            <Setter
                                Property="Foreground"
                                Value="{StaticResource AttentionBrush700}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>