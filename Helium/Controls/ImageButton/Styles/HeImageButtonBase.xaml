<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:imageButton="clr-namespace:Helium.Controls.ImageButton">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="HeImageButtonBase" TargetType="{x:Type imageButton:HeImageButtonBase}">
        <Setter Property="Width" Value="{StaticResource Width12X}"/>
        <Setter Property="Height" Value="{StaticResource Height}"/>
        
        <Setter Property="CornerRadius" Value="{StaticResource Radius4}"/>
        
        <Setter Property="FontSize" Value="{StaticResource FontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

</ResourceDictionary>