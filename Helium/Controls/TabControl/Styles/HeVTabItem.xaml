<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tabControl="clr-namespace:Helium.Controls.TabControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="HeVTabItemL0" TargetType="{x:Type tabControl:HeVTabItem}">
        <Grid
            x:Name="Root"
            Width="{StaticResource Width12X}"
            Height="{StaticResource Height15X}"
            Margin="0, 0, 0, 4">
            <Border
                x:Name="Border"
                Width="Auto"
                Height="Auto"
                BorderThickness="0"
                CornerRadius="4"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="{TemplateBinding Background}">

                <ContentPresenter
                    x:Name="ContentSite"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True"

                    TextBlock.TextAlignment="Center"

                    TextBlock.FontSize="{TemplateBinding FontSize}"
                    TextBlock.FontFamily="{TemplateBinding FontFamily}"
                    TextBlock.Foreground="{StaticResource PrimaryBrush50}" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="False" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush500}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="False" />
                    <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Panel.ZIndex" Value="100" />
                <Setter Property="Background" Value="{StaticResource PrimaryBrush500}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Panel.ZIndex" Value="100" />
                <Setter Property="Background" Value="{StaticResource PrimaryBrush500}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush600}" />
            </MultiTrigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush700}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush950}" />
                <Setter Property="TextBlock.Foreground" TargetName="ContentSite"
                        Value="{StaticResource PrimaryBrush700}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

     <ControlTemplate x:Key="HeVTabItemL1" TargetType="{x:Type tabControl:HeVTabItem}" >
        <Grid
            x:Name="Root"
            Width="{StaticResource Width12X}"
            Height="{StaticResource Height15X}"
            Margin="{TemplateBinding Margin}">
            
            <Border
                x:Name="Border"
                Width="Auto"
                Height="Auto"
                CornerRadius="0, 4, 4, 0"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="{TemplateBinding Background}">
                
                <ContentPresenter
                    x:Name="ContentSite"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True"

                    TextBlock.TextAlignment="Center"

                    TextBlock.FontSize="{TemplateBinding FontSize}"
                    TextBlock.FontFamily="{TemplateBinding FontFamily}"
                    TextBlock.Foreground="{StaticResource PrimaryBrush50}" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="False" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BlackBrush500}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="False" />
                    <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Panel.ZIndex" Value="100" />
                <Setter Property="Background" Value="{StaticResource BlackBrush700}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Panel.ZIndex" Value="100" />
                <Setter Property="Background" Value="{StaticResource BlackBrush700}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BlackBrush600}" />
            </MultiTrigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BlackBrush700}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BlackBrush950}" />
                <Setter Property="TextBlock.Foreground" TargetName="ContentSite"
                        Value="{StaticResource PrimaryBrush700}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    

    <Style TargetType="{x:Type tabControl:HeVTabItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Style.Triggers>
            <Trigger Property="Level" Value="0">
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{StaticResource HeVTabItemL0}"/>
            </Trigger>
            
            <Trigger Property="Level" Value="1">
                <Setter Property="Template" Value="{StaticResource HeVTabItemL1}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>