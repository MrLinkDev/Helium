<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:verticalTabControl="clr-namespace:Helium.Controls.VerticalTabControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="verticalTabControl:HeVerticalTabLabel">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type verticalTabControl:HeVerticalTabLabel}">
                    <Grid
                        x:Name="Root"
                        Width="{StaticResource Width12X}"
                        Height="{StaticResource Height07X}"
                        Margin="0, 0, 0, 4">
                        <Border
                            x:Name="Border"
                            Width="Auto"
                            Height="Auto"
                            BorderThickness="0"
                            CornerRadius="4"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Background="{TemplateBinding Background}">
                
                            <TextBlock
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            
                                TextAlignment="Center"
                            
                                FontSize="{TemplateBinding FontSize}"
                                FontFamily="{TemplateBinding FontFamily}"
                                Foreground="{StaticResource PrimaryBrush50}"
                            
                                Text="{TemplateBinding Header}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>