<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.Controls.XRadioButton">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="HeXRadioButtonFlatDefault" TargetType="{x:Type local:HeXRadioButton}">
        <Border
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"

            Background="{TemplateBinding Background}"

            CornerRadius="{TemplateBinding CornerRadius}"

            SnapsToDevicePixels="True">

            <DockPanel
                LastChildFill="False">
                <Grid
                    DockPanel.Dock="Left"
                    SnapsToDevicePixels="True">
                    
                    <Ellipse
                        Height="{StaticResource XEllipseSize}"
                        Width="{StaticResource XEllipseSize}"

                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        
                        Margin="4, 4, 4, 0"

                        Fill="{TemplateBinding EllipseFill}"
                        Stroke="{TemplateBinding StrokeFill}"
                        StrokeThickness="2">
                    </Ellipse>
                </Grid>

                <ContentPresenter
                    DockPanel.Dock="Left"
                    Margin="4, 0, 0, 0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="{TemplateBinding Content}" />
            </DockPanel>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="False">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush500}" />
                
                <Setter Property="EllipseFill" Value="{StaticResource PrimaryBrush800}" />
                <Setter Property="StrokeFill" Value="{StaticResource PrimaryBrush700}" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush600}" />
                
                <Setter Property="EllipseFill" Value="{StaticResource PrimaryBrush900}" />
                <Setter Property="StrokeFill" Value="{StaticResource PrimaryBrush800}" />
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
                <Setter Property="EllipseFill" Value="{StaticResource GreenBrush500}" />
                <Setter Property="StrokeFill" Value="{StaticResource GreenBrush800}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush700}" />
                
                <Setter Property="EllipseFill" Value="{StaticResource PrimaryBrush950}" />
                <Setter Property="StrokeFill" Value="{StaticResource PrimaryBrush900}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush950}" />
                
                <Setter Property="EllipseFill" Value="{StaticResource PrimaryBrush900}" />
                <Setter Property="StrokeFill" Value="{StaticResource PrimaryBrush700}" />

                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush700}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>