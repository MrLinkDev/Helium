<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.Controls.CheckBox">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml"/>
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml"/>
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type local:HeCheckBox}">
        <Setter Property="Height" Value="{StaticResource Height}"/>
        
        <Setter Property="FontSize" Value="{StaticResource FontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeCheckBox}">
                    <DockPanel
                        LastChildFill="False">
                        <Border
                            DockPanel.Dock="Left"
                            Height="{StaticResource CheckBoxSize}"
                            Width="{StaticResource CheckBoxSize}"
                            
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            
                            Background="{TemplateBinding CheckBoxFill}"
                            
                            BorderBrush="{TemplateBinding CheckBoxStroke}"
                            BorderThickness="{StaticResource CheckBoxStrokeSize}"
                            
                            CornerRadius="{StaticResource CheckBoxCornerRadius}"
                            SnapsToDevicePixels="True">
                        
                            <Path 
                                Fill="{TemplateBinding CheckBoxFigureFill}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                                <Path.Data>
                                    <PathGeometry Figures="M 0,6 L 1.5,4.5 4,7 10,1 11.5,2.5 4,10 Z"/>
                                </Path.Data>
                            </Path>
                        </Border>
                        
                        <ContentPresenter
                            DockPanel.Dock="Left"
                            Margin="4, 0, 0, 0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="{TemplateBinding Content}"/>
                    </DockPanel>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="CheckBoxStroke" Value="{StaticResource PrimaryBrush600}"/>
                        </Trigger>
                        
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="CheckBoxFigureFill" Value="{StaticResource PrimaryBrush50}"/>
                            <Setter Property="CheckBoxFill" Value="{StaticResource PrimaryBrush500}"/>
                        </Trigger>
                        
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            
                            <MultiTrigger.Setters>
                                <Setter Property="CheckBoxFill" Value="{StaticResource PrimaryBrush600}"/>
                                <Setter Property="CheckBoxStroke" Value="{StaticResource PrimaryBrush600}"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="CheckBoxStroke" Value="{StaticResource PrimaryBrush700}"/>
                        </Trigger>
                        
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            
                            <MultiTrigger.Setters>
                                <Setter Property="CheckBoxFill" Value="{StaticResource PrimaryBrush700}"/>
                                <Setter Property="CheckBoxStroke" Value="{StaticResource PrimaryBrush700}"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="CheckBoxStroke" Value="{StaticResource PrimaryBrush950}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>