<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="clr-namespace:Helium.Controls.RadioButton">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml"/>
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml"/>
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type button:HeRadioButton}">
        <Setter Property="Width" Value="{StaticResource Width12X}"/>
        <Setter Property="Height" Value="{StaticResource Height}"/>
        
        <Setter Property="FontSize" Value="{StaticResource FontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type button:HeRadioButton}">
                    <DockPanel
                        LastChildFill="False">
                        <Grid
                            DockPanel.Dock="Left"
                            SnapsToDevicePixels="True">
                            <Ellipse
                                Height="{StaticResource EllipseSize}"
                                Width="{StaticResource EllipseSize}"
                            
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            
                                Fill="{TemplateBinding EllipseFill}"
                            
                                Stroke="{TemplateBinding EllipseStroke}"
                                StrokeThickness="{StaticResource EllipseStrokeSize}">
                            </Ellipse>
                        
                            <Ellipse
                                Height="{StaticResource EllipseInnerSize}"
                                Width="{StaticResource EllipseInnerSize}"
                            
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                            
                                Fill="{TemplateBinding EllipseInnerFill}"/>
                        </Grid>
                        
                        <ContentPresenter
                            DockPanel.Dock="Left"
                            Margin="4, 0, 0, 0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="{TemplateBinding Content}"/>
                    </DockPanel>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="EllipseInnerFill" Value="{StaticResource PrimaryBrush800}"/>
                        </Trigger>
                        
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="EllipseInnerFill" Value="{StaticResource PrimaryBrush500}"/>
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="EllipseInnerFill" Value="{StaticResource PrimaryBrush900}"/>
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="EllipseStroke" Value="{StaticResource PrimaryBrush900}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>