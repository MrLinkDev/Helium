<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="clr-namespace:Helium.Controls.RadioButton">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml"/>
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml"/>
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type button:HeRadioButton}">
        <Setter Property="Width" Value="{StaticResource Width12X}"/>
        <Setter Property="Height" Value="{StaticResource Height}"/>
        
        <Setter Property="FontSize" Value="{StaticResource FontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type button:HeRadioButton}">
                    <Grid>
                        <Ellipse
                            Height="{StaticResource EllipseSize}"
                            Width="{StaticResource EllipseSize}"
                            
                            Margin="5"
                            
                            Fill="{StaticResource PrimaryBrush500}">
                        </Ellipse>
                        
                        <Ellipse
                            Height="{StaticResource EllipseSize}"
                            Width="{StaticResource EllipseSize}"
                            
                            Fill="{StaticResource WhiteBrush}"/>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor600}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor700}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
        
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor400}"/>
                                        <GradientStop Offset="0.2" Color="{StaticResource PrimaryColor600}"/>
                                        <GradientStop Offset="0.7" Color="{StaticResource PrimaryColor700}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor900}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor700}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor800}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
        
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor500}"/>
                                        <GradientStop Offset="0.2" Color="{StaticResource PrimaryColor700}"/>
                                        <GradientStop Offset="0.7" Color="{StaticResource PrimaryColor800}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor950}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush950}"/>
                            
                            <Setter Property="BorderThickness" Value="{StaticResource Thickness0}"/>
                            
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush700}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>