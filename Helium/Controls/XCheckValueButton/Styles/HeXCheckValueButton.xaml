<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="clr-namespace:Helium.Controls.XCheckValueButton"
                    xmlns:heButton="clr-namespace:Helium.Controls.Button"
                    xmlns:xValueButton="clr-namespace:Helium.Controls.XValueButton">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Dimensions.xaml" />

        <ResourceDictionary
            Source="/Alexander.Gorbunov.Helium;component/Controls/XRadioButton/Styles/Templates/HeXRadioButtonFlatTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type button:HeXCheckValueButton}">
        <Setter Property="Width" Value="{StaticResource Width12X}" />
        <Setter Property="Height" Value="{StaticResource Height15X}" />

        <Setter Property="CornerRadius" Value="{StaticResource Radius4}" />

        <Setter Property="FontSize" Value="{StaticResource FontSize}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type button:HeXCheckValueButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Indicator"
                            Grid.Column="0"

                            Width="Auto"
                            Height="Auto"

                            BorderThickness="2"
                            CornerRadius="{TemplateBinding CornerRadius}"

                            SnapsToDevicePixels="True"

                            Margin="0, 0, 2, 0">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush800}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush500}"/>
                                    
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource PrimaryBrush500}" />
                                            <Setter Property="Background"
                                                    Value="{StaticResource PrimaryBrush700}" />
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource PrimaryBrush600}" />
                                            <Setter Property="Background"
                                                    Value="{StaticResource PrimaryBrush800}" />
                                        </Trigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource PrimaryBrush950}" />
                                            <Setter Property="Background"
                                                    Value="{StaticResource PrimaryBrush900}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <xValueButton:HeXValueButton
                            x:Name="CheckButton"
                            Grid.Column="1" 
                            
                            Width="Auto"
                            Height="Auto"
                            
                            MinValue="{TemplateBinding MinValue}"
                            MaxValue="{TemplateBinding MaxValue}"
                            Value="{TemplateBinding Value}"
                            
                            ValueName="{TemplateBinding ValueName}"
                            FullValueName="{TemplateBinding FullValueName}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush500}" />
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{StaticResource PrimaryBrush100}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush500}" />
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{StaticResource GreenBrush500}" />
                        </Trigger>

                        <!-- <Trigger Property="IsPressed" Value="True"> -->
                        <!--     <Setter TargetName="Indicator" Property="BorderBrush" -->
                        <!--             Value="{StaticResource PrimaryBrush700}" /> -->
                        <!--     <Setter TargetName="Indicator" Property="Background" -->
                        <!--             Value="{StaticResource PrimaryBrush900}" /> -->
                        <!-- </Trigger> -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>