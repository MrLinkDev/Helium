<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.Controls.Window"
                    xmlns:imageButton="clr-namespace:Helium.Controls.ImageButton"
                    xmlns:editText="clr-namespace:Helium.Controls.EditText"
                    xmlns:button="clr-namespace:Helium.Controls.Button">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:HeXWindow}">
        <Setter Property="MaxWidth" Value="{StaticResource XWindowWidth}"/>
        <Setter Property="MaxHeight" Value="{StaticResource XWindowHeight}"/>
        
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        
        <Setter Property="ResizeMode" Value="NoResize"/>
        
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeXWindow">
                    <Border
                        Width="{StaticResource XWindowWidth}"
                        Height="{StaticResource XWindowHeight}"
                        
                        BorderThickness="{StaticResource Thickness2}"
                        BorderBrush="{StaticResource PrimaryBrush500}"
                        
                        Background="{StaticResource BlackBrush900}"
                        
                        CornerRadius="{StaticResource Radius4}"
                        Padding="4">
                        
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="{x:Type button:HeButtonFlat}">
                                    <Setter Property="Margin" Value="4"/>
                                    
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="Height" Value="Auto"/>
                                    
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </Grid.Resources>
                            
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Row 0 --> 
                            
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                
                                Width="Auto"
                                Height="Auto"
                            
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                            
                                TextAlignment="Left"
                            
                                FontSize="{StaticResource FontSize}"
                                Foreground="{StaticResource PrimaryBrush50}"
                            
                                Margin="4, 0, 0, 0"
                            
                                Text="Start frequency:"/>
                            
                            <editText:HeEditText
                                Grid.Row="0"
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                Width="Auto"
                                Margin="4, 0"/>
                            
                            <!-- Row 1 --> 
                            
                            <button:HeButtonFlat
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Close"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Clear"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="back"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="1"
                                Grid.Column="3"
                                Text="G"/>
                            
                            <!-- Row 2 --> 
                            
                            <button:HeButtonFlat
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="7"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="8"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="2"
                                Grid.Column="2"
                                Text="9"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="2"
                                Grid.Column="3"
                                Text="M"/>
                            
                            <!-- Row 3 --> 
                            
                            <button:HeButtonFlat
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="4"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="5"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="3"
                                Grid.Column="2"
                                Text="6"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="3"
                                Grid.Column="3"
                                Text="K"/>
                            
                            <!-- Row 4 --> 
                            
                            <button:HeButtonFlat
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="1"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="2"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="4"
                                Grid.Column="2"
                                Text="3"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="4"
                                Grid.Column="3"
                                Text="U"/>
                            
                            <!-- Row 5 --> 
                            
                            <button:HeButtonFlat
                                Grid.Row="5"
                                Grid.Column="0"
                                Text="0"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="."/>
                            
                            <button:HeButtonFlat
                                Grid.Row="5"
                                Grid.Column="2"
                                Text="+/-"/>
                            
                            <button:HeButtonFlat
                                Grid.Row="5"
                                Grid.Column="3"
                                Text="Enter"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>