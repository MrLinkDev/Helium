<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="clr-namespace:Helium.Controls.XCheckButton">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium;component/Resources/Dimensions.xaml" />

        <ResourceDictionary
            Source="/Helium;component/Controls/XRadioButton/Styles/Templates/HeXRadioButtonFlatTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type button:HeXCheckButton}">
        <Setter Property="Width" Value="{StaticResource Width12X}" />
        <Setter Property="Height" Value="{StaticResource Height15X}" />

        <Setter Property="CornerRadius" Value="{StaticResource Radius4}" />

        <Setter Property="FontSize" Value="{StaticResource FontSize}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type button:HeXCheckButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Indicator"
                            Grid.Column="0"

                            Width="Auto"
                            Height="{TemplateBinding Height}"

                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"

                            Background="{TemplateBinding Background}"

                            CornerRadius="{TemplateBinding CornerRadius}"

                            SnapsToDevicePixels="True"

                            Margin="0, 0, 4, 0">
                        </Border>

                        <Border
                            x:Name="Content"
                            Grid.Column="1"

                            Width="Auto"
                            Height="{TemplateBinding Height}"

                            Background="{TemplateBinding Background}"

                            CornerRadius="{TemplateBinding CornerRadius}"

                            SnapsToDevicePixels="True"

                            HorizontalAlignment="Stretch">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="4, 0, 4, 2"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PrimaryBrush500}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryBrush700}" />

                            <Setter TargetName="Content" Property="Background" Value="{StaticResource PrimaryBrush500}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PrimaryBrush600}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryBrush800}" />

                            <Setter TargetName="Content" Property="Background" Value="{StaticResource PrimaryBrush600}" />
                        </Trigger>
                        
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PrimaryBrush500}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource OrangeBrush500}" />
                            
                            <Setter TargetName="Content" Property="Background" Value="{StaticResource PrimaryBrush500}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PrimaryBrush500}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource GreenBrush500}" />
                            
                            <Setter TargetName="Content" Property="Background" Value="{StaticResource PrimaryBrush500}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PrimaryBrush700}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryBrush900}" />

                            <Setter TargetName="Content" Property="Background" Value="{StaticResource PrimaryBrush700}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PrimaryBrush950}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryBrush900}" />
                            
                            <Setter TargetName="Content" Property="Background" Value="{StaticResource PrimaryBrush950}" />

                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush950}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>