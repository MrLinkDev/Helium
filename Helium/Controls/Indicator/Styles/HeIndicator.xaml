<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="clr-namespace:Helium.Controls.Button"
                    xmlns:indicator="clr-namespace:Helium.Controls.Indicator">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium;component/Controls/Indicator/Styles/Templates/HeConnectionIndicatorTemplates.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type indicator:HeIndicator}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        
        <Setter Property="Template" Value="{StaticResource HeConnectionIndicator}"/>
        
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HeTheme" Value="Default"/>
                    <Condition Property="HeIndicatorType" Value="Connection"/>
                </MultiTrigger.Conditions>
                
                <MultiTrigger.Setters>
                    <Setter Property="Template" Value="{StaticResource HeConnectionIndicator}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
            
            
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>