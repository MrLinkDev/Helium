<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:indicator="clr-namespace:Helium.Controls.Indicator"
                    xmlns:utilities="clr-namespace:Helium.Controls.Indicator.Utilities">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="HeConnectionIndicator" TargetType="{x:Type indicator:HeIndicator}">
        <Grid
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"

            Background="Transparent"

            SnapsToDevicePixels="True">

            <Ellipse
                x:Name="Indicator"
                
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                
                Fill="{StaticResource BlackBrush500}"
                
                Stroke="{StaticResource BlackBrush800}"
                StrokeThickness="2"/>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="State" Value="{x:Static utilities:ConnectionState.None}">
                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource BlackBrush500}"/>
                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource BlackBrush800}"/>
            </Trigger>
            
            <Trigger Property="State" Value="{x:Static utilities:ConnectionState.Connecting}">
                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource OrangeBrush400}"/>
                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource OrangeBrush600}"/>
            </Trigger>
            
            <Trigger Property="State" Value="{x:Static utilities:ConnectionState.Connected}">
                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource GreenBrush500}"/>
                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource GreenBrush800}"/>
            </Trigger>
            
            <Trigger Property="State" Value="{x:Static utilities:ConnectionState.NoConnection}">
                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource RedBrush500}"/>
                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource RedBrush800}"/>
            </Trigger>
            
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource BlackBrush500}"/>
                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource BlackBrush800}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>