<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.CardView">
    
    <Style TargetType="{x:Type local:HeCardView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeCardView}">
                    <TextBlock
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="Magenta"
                        Foreground="Aqua"
                        Text="123">
                    </TextBlock>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>