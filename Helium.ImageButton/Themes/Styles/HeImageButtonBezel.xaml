<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.ImageButton">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium.ImageButton;component/Themes/Styles/HeImageButtonBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type local:HeImageButtonBezel}" BasedOn="{StaticResource HeImageButtonBase}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource PrimaryColor500}"/>
                    <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor600}"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource PrimaryColor300}"/>
                    <GradientStop Offset="0.2" Color="{StaticResource PrimaryColor500}"/>
                    <GradientStop Offset="0.7" Color="{StaticResource PrimaryColor600}"/>
                    <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor800}"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness1}"/>
        
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeImageButtonBezel}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        
                        Background="{TemplateBinding Background}"
                        
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        
                        CornerRadius="{TemplateBinding CornerRadius}"
                        
                        SnapsToDevicePixels="True">
                        
                        <ContentPresenter
                            Width="{TemplateBinding Width}"
                            Height="Auto"
                            
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            
                            Margin="{TemplateBinding CornerRadius}"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor600}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor700}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
        
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor400}"/>
                                        <GradientStop Offset="0.2" Color="{StaticResource PrimaryColor600}"/>
                                        <GradientStop Offset="0.7" Color="{StaticResource PrimaryColor700}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor900}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor700}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor800}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
        
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{StaticResource PrimaryColor500}"/>
                                        <GradientStop Offset="0.2" Color="{StaticResource PrimaryColor700}"/>
                                        <GradientStop Offset="0.7" Color="{StaticResource PrimaryColor800}"/>
                                        <GradientStop Offset="0.9" Color="{StaticResource PrimaryColor950}"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush100}"/>
                            
                            <Setter Property="BorderThickness" Value="{StaticResource Thickness0}"/>
                            
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush400}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>