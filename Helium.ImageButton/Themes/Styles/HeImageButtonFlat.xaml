<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.ImageButton">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium.ImageButton;component/Themes/Styles/HeImageButtonBase.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:HeImageButtonFlat}" BasedOn="{StaticResource HeImageButtonBase}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush500}"/>
        
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeImageButtonFlat}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"

                        Background="{TemplateBinding Background}"

                        CornerRadius="{TemplateBinding CornerRadius}"

                        SnapsToDevicePixels="True">

                        <Grid>
                            <ContentControl>
                                <Image>
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter 
                                                Property="Source" 
                                                Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ImageSource}"/>
                                            
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter 
                                                        Property="Source" 
                                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ImageSourceDisabled}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </ContentControl>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter 
                                Property="Background" 
                                Value="{StaticResource PrimaryBrush600}"/>
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter 
                                Property="Background" 
                                Value="{StaticResource PrimaryBrush700}"/>
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter 
                                Property="Background" 
                                Value="{StaticResource PrimaryBrush950}"/>
                            
                            <Setter
                                Property="Foreground"
                                Value="{StaticResource PrimaryBrush700}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>