<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.ImageButton">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium.Values;component/Resources/Brushes.xaml"/>
        <ResourceDictionary Source="/Helium.Values;component/Resources/Colors.xaml"/>
        <ResourceDictionary Source="/Helium.Values;component/Resources/Dimensions.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="HeImageButtonBase" TargetType="{x:Type local:HeImageButtonBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeImageButtonBase}">
                    <Border
                        Width="100"
                        Height="100"
                        
                        Background="Magenta"
                        
                        BorderBrush="CornflowerBlue"
                        BorderThickness="5">
                        
                        <TextBlock
                            Width="100"
                            Height="Auto"
                            Text="Hello"></TextBlock>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>