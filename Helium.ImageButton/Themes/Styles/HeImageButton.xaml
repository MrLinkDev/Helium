<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.ImageButton">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium.Resources;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium.Resources;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium.Resources;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:HeImageButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HeImageButton}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        
                        BorderBrush="Azure"
                        BorderThickness="1">
                        
                        <!--
                        <Image Source="{TemplateBinding ImageSource}"/>
                        -->
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>