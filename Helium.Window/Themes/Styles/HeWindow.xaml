<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helium.Window">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Helium.Values;component/Resources/Brushes.xaml" />
        <ResourceDictionary Source="/Helium.Values;component/Resources/Colors.xaml" />
        <ResourceDictionary Source="/Helium.Values;component/Resources/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <LinearGradientBrush
        x:Key="GradientToolbarBackground"
        StartPoint="0,0"
        EndPoint="1,0">
        <GradientStop Offset="-0.3" Color="{StaticResource BlackColor800}" />
        <GradientStop Offset="0.3" Color="{StaticResource PrimaryColor700}" />
        <GradientStop Offset="1" Color="{StaticResource BlackColor800}" />
    </LinearGradientBrush>

    <Style x:Key="MinimizeButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Width="{StaticResource ToolbarButtonWidth}"
                        Height="{StaticResource ToolbarButtonHeight}"
                        
                        Margin="0"
                        Padding="8"
                        
                        SnapsToDevicePixels="True"
                        
                        Background="{StaticResource PrimaryBrush500}">
                        
                        <Image Source="/Helium.Values;component/Resources/Icons/32px/minimize_icon.png" />
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush600}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush700}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HeWindow}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome
                    GlassFrameThickness="1"
                    CornerRadius="8"
                    CaptionHeight="0" />
            </Setter.Value>
        </Setter>

        <Setter Property="MinWidth" Value="{StaticResource MinWindowWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource MinWindowHeight}" />

        <Setter Property="Width" Value="{StaticResource WindowWidth}" />
        <Setter Property="Height" Value="{StaticResource WindowHeight}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeWindow">
                    <DockPanel LastChildFill="True">
                        <Grid
                            DockPanel.Dock="Top"
                            Height="{StaticResource ToolbarHeight}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ToolbarTitleSectionWidth}" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="{StaticResource ToolbarButtonsSectionWidth}" />
                            </Grid.ColumnDefinitions>

                            <DockPanel
                                Grid.Column="0"
                                Background="{StaticResource PrimaryBrush500}">

                            </DockPanel>

                            <DockPanel
                                Grid.Column="1"
                                Background="{StaticResource PrimaryBrush500}">

                            </DockPanel>

                            <DockPanel
                                Grid.Column="2"
                                Background="{StaticResource PrimaryBrush500}">
                                <Button
                                    Style="{StaticResource MinimizeButtonStyle}"/>
                            </DockPanel>
                        </Grid>

                        <StackPanel
                            DockPanel.Dock="Bottom"
                            Background="{TemplateBinding BodyBackground}">

                            <ContentPresenter />
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>